# =============================================================
# Hospital Management System — Environment Configuration
# =============================================================
# Copy this file to .env and fill in the values.

# --- Database ---
DATABASE_URL="postgresql://hms_user:hms_password@localhost:54320/hms_db?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Authentication ---
JWT_SECRET="change-me-to-a-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-to-another-secure-random-string"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --- MinIO / S3 Object Storage ---
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="hms-files"
MINIO_USE_SSL="false"

# --- Application ---
NEXT_PUBLIC_APP_NAME="Hospital Management System"
NEXT_PUBLIC_APP_URL="http://localhost:30000"
NODE_ENV="development"
