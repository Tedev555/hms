generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Gender {
  male
  female
  other
}

enum UserRole {
  doctor
  nurse
  paramedic
  receptionist
  admin
  lab_tech
  pharmacist
  director
}

enum AppointmentType {
  opd
  follow_up
  emergency
  teleconsult
}

enum AppointmentStatus {
  scheduled
  confirmed
  checked_in
  in_progress
  completed
  cancelled
  no_show
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  insurance
  mixed
}

enum DrugFormulation {
  tablet
  capsule
  syrup
  injection
  cream
  inhaler
  drops
  other
}

enum LabOrderStatus {
  ordered
  sample_collected
  processing
  completed
  cancelled
}

enum BedStatus {
  available
  occupied
  reserved
  maintenance
  discharged
}

enum AdmissionStatus {
  admitted
  transferred
  discharged
  deceased
  lama
}

// ============================================================
// CORE MODELS
// ============================================================

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique @db.VarChar(10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  appointments Appointment[]
  wards        Ward[]

  @@map("departments")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  role         UserRole
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  phone        String?    @db.VarChar(20)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdById  String?
  createdBy    User?      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]     @relation("UserCreatedBy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  patientsCreated     Patient[]       @relation("PatientCreatedBy")
  doctorAppointments  Appointment[]   @relation("DoctorAppointments")
  labOrdersCreated    LabOrder[]      @relation("LabOrderCreatedBy")
  labResultsEntered   LabResult[]     @relation("LabResultEnteredBy")
  prescriptions       Prescription[]  @relation("PrescriptionDoctor")
  admissionsDoctor    Admission[]     @relation("AdmissionDoctor")
  nursingNotes        NursingNote[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([departmentId])
  @@map("users")
}

// ============================================================
// PATIENT MODULE
// ============================================================

model Patient {
  id          String   @id @default(uuid())
  patientCode String   @unique @db.VarChar(20)
  firstName   String   @db.VarChar(100)
  lastName    String   @db.VarChar(100)
  dateOfBirth DateTime @db.Date
  gender      Gender
  nationalId  String?  @unique @db.VarChar(50)
  phone       String   @db.VarChar(20)
  email       String?  @db.VarChar(150)
  address     String?  @db.Text
  bloodGroup  String?  @db.VarChar(5)
  allergies   Json?    @default("[]")
  photoUrl    String?
  createdById String?
  createdBy   User?    @relation("PatientCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  emergencyContacts EmergencyContact[]
  appointments      Appointment[]
  invoices          Invoice[]
  labOrders         LabOrder[]
  prescriptions     Prescription[]
  admissions        Admission[]
  documents         PatientDocument[]
  medicalHistory    MedicalHistory[]

  @@index([patientCode])
  @@index([phone])
  @@index([nationalId])
  @@index([lastName, firstName])
  @@map("patients")
}

model EmergencyContact {
  id           String @id @default(uuid())
  patientId    String
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String  @db.VarChar(200)
  relationship String  @db.VarChar(50)
  phone        String  @db.VarChar(20)

  @@map("emergency_contacts")
}

model MedicalHistory {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition   String   @db.VarChar(300)
  description String?  @db.Text
  diagnosedAt DateTime? @db.Date
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([patientId])
  @@map("medical_histories")
}

model PatientDocument {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(200)
  fileUrl    String
  fileType   String   @db.VarChar(50)
  uploadedAt DateTime @default(now())

  @@map("patient_documents")
}

// ============================================================
// APPOINTMENT MODULE
// ============================================================

model Appointment {
  id              String            @id @default(uuid())
  appointmentCode String            @unique @db.VarChar(20)
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  departmentId    String?
  department      Department?       @relation(fields: [departmentId], references: [id])
  scheduledAt     DateTime
  duration        Int               @default(15)
  type            AppointmentType
  status          AppointmentStatus @default(scheduled)
  chiefComplaint  String?           @db.Text
  notes           String?           @db.Text
  cancelReason    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  invoice Invoice?

  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
}

// ============================================================
// BILLING MODULE
// ============================================================

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @db.VarChar(30)
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id])
  appointmentId   String?       @unique
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  admissionId     String?
  admission       Admission?    @relation(fields: [admissionId], references: [id])
  issueDate       DateTime      @db.Date
  dueDate         DateTime      @db.Date
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus @default(draft)
  paymentMethod   PaymentMethod?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([patientId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String  @db.VarChar(300)
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  reference     String?       @db.VarChar(100)
  paidAt        DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}

// ============================================================
// PHARMACY MODULE
// ============================================================

model Drug {
  id                  String          @id @default(uuid())
  genericName         String          @db.VarChar(200)
  brandName           String?         @db.VarChar(200)
  category            String?         @db.VarChar(100)
  formulation         DrugFormulation
  strength            String?         @db.VarChar(50)
  unit                String          @db.VarChar(20)
  reorderLevel        Int             @default(10)
  currentStock        Int             @default(0)
  unitPrice           Decimal         @db.Decimal(10, 2)
  isControlled        Boolean         @default(false)
  requiresPrescription Boolean        @default(true)
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  batches            DrugBatch[]
  prescriptionItems  PrescriptionItem[]

  @@index([genericName])
  @@index([category])
  @@map("drugs")
}

model DrugBatch {
  id         String   @id @default(uuid())
  drugId     String
  drug       Drug     @relation(fields: [drugId], references: [id])
  batchNo    String   @db.VarChar(50)
  quantity   Int
  expiryDate DateTime @db.Date
  costPrice  Decimal  @db.Decimal(10, 2)
  supplier   String?  @db.VarChar(200)
  receivedAt DateTime @default(now())

  @@index([drugId])
  @@index([expiryDate])
  @@map("drug_batches")
}

model Prescription {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  doctorId   String
  doctor     User     @relation("PrescriptionDoctor", fields: [doctorId], references: [id])
  diagnosis  String?  @db.Text
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  items PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String  @id @default(uuid())
  prescriptionId  String
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drugId          String
  drug            Drug    @relation(fields: [drugId], references: [id])
  dosage          String  @db.VarChar(100)
  frequency       String  @db.VarChar(100)
  duration        String  @db.VarChar(50)
  quantity        Int
  instructions    String? @db.Text
  isDispensed     Boolean @default(false)

  @@map("prescription_items")
}

// ============================================================
// LABORATORY MODULE
// ============================================================

model LabTest {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(200)
  code           String   @unique @db.VarChar(20)
  category       String   @db.VarChar(100)
  sampleType     String   @db.VarChar(50)
  referenceRange String?  @db.Text
  unit           String?  @db.VarChar(50)
  price          Decimal  @db.Decimal(10, 2)
  turnaroundHrs  Int      @default(24)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems LabOrderItem[]

  @@index([category])
  @@map("lab_tests")
}

model LabOrder {
  id          String         @id @default(uuid())
  orderCode   String         @unique @db.VarChar(20)
  patientId   String
  patient     Patient        @relation(fields: [patientId], references: [id])
  orderedById String
  orderedBy   User           @relation("LabOrderCreatedBy", fields: [orderedById], references: [id])
  status      LabOrderStatus @default(ordered)
  priority    String         @default("routine") @db.VarChar(20)
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items LabOrderItem[]

  @@index([patientId])
  @@index([status])
  @@map("lab_orders")
}

model LabOrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testId     String
  test       LabTest  @relation(fields: [testId], references: [id])
  status     LabOrderStatus @default(ordered)

  result LabResult?

  @@map("lab_order_items")
}

model LabResult {
  id            String       @id @default(uuid())
  orderItemId   String       @unique
  orderItem     LabOrderItem @relation(fields: [orderItemId], references: [id])
  value         String       @db.Text
  unit          String?      @db.VarChar(50)
  isAbnormal    Boolean      @default(false)
  isCritical    Boolean      @default(false)
  remarks       String?      @db.Text
  enteredById   String
  enteredBy     User         @relation("LabResultEnteredBy", fields: [enteredById], references: [id])
  enteredAt     DateTime     @default(now())

  @@map("lab_results")
}

// ============================================================
// INPATIENT / WARD MODULE
// ============================================================

model Ward {
  id           String     @id @default(uuid())
  name         String     @unique @db.VarChar(100)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  floor        Int
  totalBeds    Int
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  rooms Room[]

  @@map("wards")
}

model Room {
  id       String @id @default(uuid())
  wardId   String
  ward     Ward   @relation(fields: [wardId], references: [id])
  number   String @db.VarChar(20)
  type     String @db.VarChar(50)

  beds Bed[]

  @@unique([wardId, number])
  @@map("rooms")
}

model Bed {
  id     String    @id @default(uuid())
  roomId String
  room   Room      @relation(fields: [roomId], references: [id])
  number String    @db.VarChar(10)
  status BedStatus @default(available)

  admissions Admission[]

  @@unique([roomId, number])
  @@index([status])
  @@map("beds")
}

model Admission {
  id               String          @id @default(uuid())
  admissionCode    String          @unique @db.VarChar(20)
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id])
  bedId            String
  bed              Bed             @relation(fields: [bedId], references: [id])
  attendingDoctorId String
  attendingDoctor  User            @relation("AdmissionDoctor", fields: [attendingDoctorId], references: [id])
  admittedAt       DateTime        @default(now())
  dischargedAt     DateTime?
  primaryDiagnosis String?         @db.Text
  status           AdmissionStatus @default(admitted)
  dischargeSummary String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  invoices     Invoice[]
  vitalSigns   VitalSign[]
  nursingNotes NursingNote[]

  @@index([patientId])
  @@index([status])
  @@map("admissions")
}

model VitalSign {
  id          String    @id @default(uuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id])
  temperature Decimal?  @db.Decimal(4, 1)
  systolicBP  Int?
  diastolicBP Int?
  pulse       Int?
  spO2        Decimal?  @db.Decimal(4, 1)
  respRate    Int?
  notes       String?   @db.Text
  recordedAt  DateTime  @default(now())

  @@index([admissionId, recordedAt])
  @@map("vital_signs")
}

model NursingNote {
  id          String    @id @default(uuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  note        String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([admissionId])
  @@map("nursing_notes")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(50)
  entity     String   @db.VarChar(50)
  entityId   String?  @db.VarChar(100)
  oldData    Json?
  newData    Json?
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
